{
  "name": "@thefaithapp/giving-react-native",
  "version": "0.2.1",
  "description": "Authenticated general and campaign giving UI for React Native and Expo apps.",
  "license": "MIT",
  "homepage": "https://thefaithapp.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thefaithapp/thefaithapp-giving-react-native.git"
  },
  "bugs": {
    "url": "https://github.com/thefaithapp/thefaithapp-giving-react-native/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "test": "vitest run && npm run test:security",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run security:check && npm run clean && npm run build && npm run test",
    "security:prepare": "node scripts/security-check.cjs --prepare-only",
    "security:check": "node scripts/security-check.cjs",
    "test:security": "node --test scripts/security-check.test.cjs"
  },
  "peerDependencies": {
    "@stripe/stripe-react-native": ">=0.57.0 <1.0.0",
    "@thefaithapp/auth-react-native": ">=0.1.0 <1.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.84.0",
    "react-native-webview": ">=13.0.0 <15.0.0"
  },
  "devDependencies": {
    "@stripe/stripe-react-native": "^0.64.0",
    "@thefaithapp/auth-react-native": "^0.1.0",
    "@types/react": "^19.2.17",
    "react": "^19.2.0",
    "react-native": "^0.86.0",
    "react-native-webview": "^13.16.1",
    "rimraf": "^6.1.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "thefaithapp",
    "react-native",
    "expo",
    "giving",
    "donations",
    "stripe",
    "paypal",
    "flutterwave"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
